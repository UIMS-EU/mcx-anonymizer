#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Enable once per clone:  git config core.hooksPath .githooks
# Runs optional per-clone checks of the commit message that are not part of the repository.
local_hook="$(git rev-parse --git-dir)/hooks-local/commit-msg"
if [[ -x "$local_hook" ]]; then
  exec "$local_hook" "$@"
fi

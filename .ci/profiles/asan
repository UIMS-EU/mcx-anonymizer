# GCC 14 with AddressSanitizer and UndefinedBehaviorSanitizer (all packages built with them)
include(gcc14)

[settings]
build_type=Debug

[conf]
tools.build:cflags=["-fsanitize=address,undefined","-fno-omit-frame-pointer","-g"]
tools.build:cxxflags=["-fsanitize=address,undefined","-fno-omit-frame-pointer","-g"]
tools.build:exelinkflags=["-fsanitize=address,undefined"]
tools.build:sharedlinkflags=["-fsanitize=address,undefined"]

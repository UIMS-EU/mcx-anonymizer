# GCC 14, libstdc++ (C++23 is set per build: -s compiler.cppstd=23)
[settings]
os=Linux
arch=x86_64
build_type=Release
compiler=gcc
compiler.version=14
compiler.cppstd=gnu17
compiler.libcxx=libstdc++11

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
tools.build:compiler_executables={"c": "gcc", "cpp": "g++"}

// --- payloads (zeroed or dropped per --payload) ------------------------------
FIELD(payload_l7, "payload.l7", payload)
FIELD(payload_sip, "payload.sip", payload)  // UDP/TCP payload recognised as SIP (feature 002)
FIELD(payload_media, "payload.media", payload)  // UDP payload on an SDP-announced media endpoint (feature 004)
FIELD(payload_unknown, "payload.unknown", payload)
FIELD(payload_unparsed, "payload.unparsed", payload)
FIELD(payload_fragment, "payload.fragment", payload)
FIELD(payload_encrypted, "payload.encrypted", payload)
FIELD(icmp_data, "icmp.data", payload)


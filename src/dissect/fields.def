// SPDX-License-Identifier: GPL-3.0-or-later
//
// Every field the dissectors and the pcapng metadata handling can emit:
//   FIELD(identifier, "FieldId", kind)
// The rule set (rules/*.yaml) must classify each FieldId exactly once.

// --- link layer -------------------------------------------------------------
FIELD(eth_dst, "eth.dst", address_mac)
FIELD(eth_src, "eth.src", address_mac)
FIELD(eth_type, "eth.type", numeric)
FIELD(eth_fcs, "eth.fcs", checksum)
FIELD(link_trailer, "link.trailer", opaque)
FIELD(vlan_tci, "vlan.tci", vlan)
FIELD(vlan_type, "vlan.type", numeric)
FIELD(sll_pkttype, "sll.pkttype", numeric)
FIELD(sll_hatype, "sll.hatype", numeric)
FIELD(sll_halen, "sll.halen", numeric)
FIELD(sll_addr, "sll.addr", address_mac)
FIELD(sll_addr_pad, "sll.addr_pad", opaque)
FIELD(sll_addr_other, "sll.addr_other", opaque)
FIELD(sll_protocol, "sll.protocol", numeric)
FIELD(sll2_protocol, "sll2.protocol", numeric)
FIELD(sll2_reserved, "sll2.reserved", numeric)
FIELD(sll2_ifindex, "sll2.ifindex", numeric)
FIELD(sll2_hatype, "sll2.hatype", numeric)
FIELD(sll2_pkttype, "sll2.pkttype", numeric)
FIELD(sll2_halen, "sll2.halen", numeric)
FIELD(sll2_addr, "sll2.addr", address_mac)
FIELD(sll2_addr_pad, "sll2.addr_pad", opaque)
FIELD(sll2_addr_other, "sll2.addr_other", opaque)
FIELD(null_family, "null.family", numeric)
FIELD(arp_fixed, "arp.fixed", numeric)
FIELD(arp_sha, "arp.sha", address_mac)
FIELD(arp_spa, "arp.spa", address_ipv4)
FIELD(arp_tha, "arp.tha", address_mac)
FIELD(arp_tpa, "arp.tpa", address_ipv4)

